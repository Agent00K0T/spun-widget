#!/usr/bin/python3 -I
"""Chapters of a YouTube video for Spun Widget, without an account or cookies.

Asks YouTube's own web API (youtubei/v1/next, the one its site uses): ~80 KB instead of the
1.6 MB watch page. If the API doesn't answer as expected, reads the chapters from the watch page.
(yt-dlp doesn't do: without cookies it keeps hitting "Sign in to confirm you're not a bot".)

Output, one value per line (like yt-dlp --print):
  1) the duration in seconds, or NA,
  2) the chapters as JSON: [{"start_time": seconds, "title": "…"}],
  3) the ID of the video that comes next (next in the playlist, or autoplay), or an empty line.
Exit code 1: nothing could be fetched (the widget tries again later).
"""
import json
import re
import sys
import urllib.parse
import urllib.request

USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"
API = "https://www.youtube.com/youtubei/v1/next?prettyPrint=false"
CLIENT = {"clientName": "WEB", "clientVersion": "2.20261001.00.00", "hl": "ru"}
CHAPTER = re.compile(r'"chapterRenderer":\{"title":\{"simpleText":("(?:[^"\\]|\\.)*")\},"timeRangeStartMillis":(\d+)')
DURATION = (re.compile(r'"lengthSeconds":"(\d+)"'), re.compile(r'"approxDurationMs":"(\d+)"'))


def video_id(url):
    parts = urllib.parse.urlparse(url)
    if parts.hostname == "youtu.be":
        return parts.path.strip("/").split("/")[0]
    path = parts.path.strip("/").split("/")
    if len(path) >= 2 and path[0] in ("shorts", "live", "embed"):
        return path[1]
    return urllib.parse.parse_qs(parts.query).get("v", [""])[0]


def walk(node, key):
    """Every value of key at any depth of the JSON."""
    if isinstance(node, dict):
        for k, v in node.items():
            if k == key:
                yield v
            yield from walk(v, key)
    elif isinstance(node, list):
        for v in node:
            yield from walk(v, key)


def from_api(url):
    body = {"context": {"client": CLIENT}, "videoId": video_id(url)}
    if playlist := urllib.parse.parse_qs(urllib.parse.urlparse(url).query).get("list", [""])[0]:
        body["playlistId"] = playlist
    request = urllib.request.Request(API, data=json.dumps(body).encode(), headers={
        "Content-Type": "application/json", "User-Agent": USER_AGENT})
    data = json.load(urllib.request.urlopen(request, timeout=20))
    if "contents" not in data:
        raise ValueError("unexpected answer")
    chapters = {}
    for chapter in walk(data, "chapterRenderer"):
        start = chapter.get("timeRangeStartMillis")
        title = chapter.get("title", {}).get("simpleText", "")
        if isinstance(start, int):
            chapters.setdefault(start, title)   # chapters repeat in several places of the answer
    # Next in the playlist, otherwise what YouTube plays after this video
    following = ""
    for key in ("nextButtonVideo", "autoplayVideo"):
        for endpoint in walk(data, key):
            following = following or endpoint.get("watchEndpoint", {}).get("videoId", "")
    return "NA", chapters, following


def from_page(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept-Language": "ru,en;q=0.8"})
    page = urllib.request.urlopen(request, timeout=20).read().decode("utf-8", "replace")
    chapters = {}
    for title, start in CHAPTER.findall(page):
        chapters.setdefault(int(start), json.loads(title))
    duration = "NA"
    if match := DURATION[0].search(page):
        duration = match.group(1)
    elif match := DURATION[1].search(page):
        duration = str(int(match.group(1)) / 1000)
    return duration, chapters, ""


def main():
    url = sys.argv[1]
    try:
        duration, chapters, following = from_api(url)
    except Exception as error:
        print("API:", error, file=sys.stderr)
        try:
            duration, chapters, following = from_page(url)
        except Exception as error:
            print(error, file=sys.stderr)
            return 1
    print(duration)
    print(json.dumps([{"start_time": start / 1000, "title": title} for start, title in sorted(chapters.items())], ensure_ascii=False))
    print(following)
    return 0


if __name__ == "__main__":
    sys.exit(main())
